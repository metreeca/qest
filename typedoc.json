{
  "tsconfig": "./tsconfig.build.json",
  "highlightLanguages": [
    "http"
  ],
  "ignoredHighlightLanguages": [
    "abnf",
    "cddl"
  ],
  "externalSymbolLinkMappings": {
    "@metreeca/core": {
      "isIdentifier": "https://metreeca.github.io/core/functions/index.isIdentifier.html",
      "Identifier": "https://metreeca.github.io/core/types/index.Identifier.html",
      "IRI": "https://metreeca.github.io/core/types/resource.IRI.html",
      "Variant": "https://metreeca.github.io/core/types/resource.Variant.html",
      "internalize": "https://metreeca.github.io/core/functions/resource.internalize.html",
      "resolve": "https://metreeca.github.io/core/functions/resource.resolve.html",
      "Tag": "https://metreeca.github.io/core/types/language.Tag.html",
      "TagRange": "https://metreeca.github.io/core/types/language.TagRange.html",
      "immutable": "https://metreeca.github.io/core/functions/nested.immutable.html"
    },
    "typescript": {
      "encodeURIComponent": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURIComponent"
    }
  },
  "includeVersion": true,
  "sortEntryPoints": false,
  "sort": [
    "source-order"
  ],
  "groupOrder": [
    "Variables",
    "Type Aliases",
    "*"
  ],
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "navigationLinks": {
    "GitHub": "https://github.com/metreeca/qest"
  },
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://metreeca.com/assets/icon.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  }
}
