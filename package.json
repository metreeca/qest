{
  "name": "@metreeca/qest",
  "version": "0.13.0",
  "description": "Foundations for client-driven, queryable REST/JSON APIs.",
  "keywords": [
    "typescript",
    "rest",
    "json",
    "json-ld",
    "query",
    "api"
  ],
  "homepage": "https://metreeca.github.io/qest/",
  "bugs": {
    "url": "https://github.com/metreeca/qest/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/qest.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./state": {
      "@metreeca/source": "./src/state.ts",
      "default": "./dist/state.js"
    },
    "./model": {
      "@metreeca/source": "./src/model.ts",
      "default": "./dist/model.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules 'src/*.pegjs.*'",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "peggy": "npx peggy --dts --format es --allowed-start-rules '*' --output src/model.pegjs.js src/model.pegjs",
    "build": "rm dist docs && npm run peggy && tsc -p tsconfig.build.json && cp dist 'src/*.pegjs.*' && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.13.0"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.5.0",
    "@web/dev-server": "^1.0.0",
    "peggy": "^4.1.3",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
